{
  "name": "@oxog/scrollex",
  "version": "1.0.3",
  "description": "Zero-dependency React virtualization library with micro-kernel plugin architecture",
  "author": {
    "name": "Ersin KOC",
    "url": "https://github.com/ersinkoc"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ersinkoc/Scrollex.git"
  },
  "homepage": "https://scrollex.oxog.dev",
  "bugs": {
    "url": "https://github.com/ersinkoc/Scrollex/issues"
  },
  "keywords": [
    "react",
    "virtualization",
    "virtual-list",
    "virtual-scroll",
    "infinite-scroll",
    "virtual-grid",
    "masonry",
    "performance",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins/index.d.ts",
        "default": "./dist/plugins/index.js"
      },
      "require": {
        "types": "./dist/plugins/index.d.cts",
        "default": "./dist/plugins/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node -e \"const fs=require('fs');const files=['dist/index.js','dist/index.cjs','dist/index.d.ts','dist/index.d.cts','dist/index.js.map','dist/index.cjs.map','dist/plugins/index.js','dist/plugins/index.cjs','dist/plugins/index.d.ts','dist/plugins/index.d.cts','dist/plugins/index.js.map','dist/plugins/index.cjs.map'];const missing=files.filter(f=>!fs.existsSync(f));if(missing.length){console.error('Build incomplete - missing: '+missing.join(', '));process.exit(1)};console.log('Build verified: 12/12 dist files present.')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.1.2",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^23.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^9.0.0",
    "typescript": "^5.3.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.11.0 || >=26.0.0",
      "onFail": "warn"
    }
  }
}
